#################################################################
#    Annotations
#################################################################

:AbsenceDuration rdfs:label "Absence Duration"@en ,
                            "Duração da Ausência"@pt-br ,
                            "欠席期間"@ja .


:AbsenceMotive rdfs:label "Absence Motive"@en ,
                          "Motivo da Ausência"@pt-br ,
                          "欠席理由"@ja .


:AbsentStudent rdfs:label "Absent Student"@en ,
                          "Estudante Ausente"@pt-br ,
                          "不登校"@ja .


:ActivityReport rdfs:label "Ativity Report"@en ,
                           "Relatório de Atividades"@pt-br ,
                           "活動報告書"@ja .


:AlternativeLearningSession rdfs:label "Alternative Learning Session"@en ,
                                       "Sessão de Aprendizagem Alternativa"@pt-br ,
                                       "代替学習セッション"@ja .


:DigitalCheckupSOS rdfs:label "Checkup Digital/SOS"@pt-br ,
                              "Digital Checkup/SOS"@en ,
                              "デジタルチェックアップ/SOS"@ja .


:Director rdfs:label "Director"@en ,
                     "Diretor"@pt-br ,
                     "校長"@ja .


:DirectorsTrial rdfs:label "Avaliação do Diretor"@pt-br ,
                           "Director's Trial"@en ,
                           "校長の判断"@ja .


:Document rdfs:label "Document"@en ,
                     "Documento"@pt-br ,
                     "文書"@ja .


:EconomicReason rdfs:label "Economic Reason"@en ,
                           "Motivo Econômico"@pt-br ,
                           "経済的理由"@ja .


:EducationSupportCenter rdfs:label "Centro de Apoio à Educação"@pt-br ,
                                   "Education Support Center"@en ,
                                   "教育支援センター"@ja .


:ExcludedFactor rdfs:label "Excluded Factor"@en ,
                           "Fator Excluído"@pt-br ,
                           "除外要因"@ja .


:FreeSchool rdfs:label "Escola Livre"@pt-br ,
                       "Free School"@en ,
                       "フリースクール"@ja .


:HomeICT rdfs:label "Casa (TIC)"@pt-br ,
                    "Home (ICT)"@en ,
                    "家庭（ICT）"@ja .


:InSchoolSupportCenter rdfs:label "Centro de Apoio Interno à Escola"@pt-br ,
                                  "In-School Support Center"@en ,
                                  "校内サポートルーム"@ja .


:InterventionPlanning rdfs:label "Intervantion Planning"@en ,
