@prefix : <http://example.com/school-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gufo: <http://purl.org/nemo/gufo#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://example.com/school-ontology#> .

<http://example.com/school-ontology> rdf:type owl:Ontology ;
                                      owl:imports <http://purl.org/nemo/gufo#/1.0.0> ;
                                      <http://purl.org/dc/elements/1.1/creator> "Matheus Medeiros" ;
                                      <http://purl.org/dc/elements/1.1/title> "Administrative Process for School Refusal Registration" ;
                                      rdfs:comment "Ontologia do contexto escolar baseada em gUFO (Visão Geral + Avaliação de Recusa Escolar + Triagem e Intervenção)."@pt .

#################################################################
#    Object Properties
#################################################################

###  http://example.com/school-ontology#comparativeAbsenceDuration
:comparativeAbsenceDuration rdf:type owl:ObjectProperty ;
                            rdfs:domain :SchoolRefusalClassification ;
                            rdfs:range :AbsenceDuration ;
                            rdfs:label "comparative"@en .


###  http://example.com/school-ontology#comparativePsychosocial
:comparativePsychosocial rdf:type owl:ObjectProperty ;
                         rdfs:domain :SchoolRefusalClassification ;
                         rdfs:range :PsychosocialFactor ;
                         rdfs:label "comparative"@en .


###  http://example.com/school-ontology#deliveryTo
:deliveryTo rdf:type owl:ObjectProperty ,
                     owl:FunctionalProperty ;
            rdfs:domain :StudentRecord ;
            rdfs:range :MEXT ;
            rdfs:label "Delivery To"@en .


###  http://example.com/school-ontology#directorParticipatesInTrial
:directorParticipatesInTrial rdf:type owl:ObjectProperty ;
                             rdfs:subPropertyOf gufo:participatedIn ;
                             rdfs:domain :Director ;
                             rdfs:range :DirectorsTrial .


###  http://example.com/school-ontology#facilityOccursInSession
:facilityOccursInSession rdf:type owl:ObjectProperty ,
                                  owl:IrreflexiveProperty ;
                         rdfs:domain :AlternativeLearningSession ;
                         rdfs:range :LearningFacility ;
                         rdfs:label "Occurs IN"@en .


###  http://example.com/school-ontology#hasAbsenceMotive
:hasAbsenceMotive rdf:type owl:ObjectProperty ,
                           owl:IrreflexiveProperty ;
                  rdfs:domain :Student ;
                  rdfs:range :ExcludedFactor .


###  http://example.com/school-ontology#informedBy
:informedBy rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf gufo:mediates ;
            rdfs:domain :DigitalCheckupSOS ;
            rdfs:range :TeamSchool .


###  http://example.com/school-ontology#isComponentOfSchool
:isComponentOfSchool rdf:type owl:ObjectProperty ;
                     rdfs:subPropertyOf gufo:isComponentOf ;
                     rdf:type owl:TransitiveProperty ;
                     rdfs:domain :TeamSchool ;
                     rdfs:range :School .


###  http://example.com/school-ontology#isMemberOfTeamSchool
:isMemberOfTeamSchool rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf gufo:isCollectionMemberOf ;
                      rdfs:domain [ rdf:type owl:Class ;
                                    owl:unionOf ( :SchoolCounselor
                                                  :SchoolSocialWorker
                                                  :Teacher
                                                )
                                  ] ;
                      rdfs:range :TeamSchool .


###  http://example.com/school-ontology#monitoredBy
:monitoredBy rdf:type owl:ObjectProperty ,
                      owl:InverseFunctionalProperty ,
                      owl:AsymmetricProperty ,
                      owl:IrreflexiveProperty ;
             rdfs:domain :Student ;
             rdfs:range :TeamSchool ;
             rdfs:label "Monitored by"@en .


###  http://example.com/school-ontology#participatesInScreening
:participatesInScreening rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf gufo:participatedIn ;
                         rdfs:domain [ rdf:type owl:Class ;
                                       owl:unionOf ( :Parent
                                                     :SchoolCounselor
                                                     :Student
                                                     :Teacher
                                                     :TeamSchool
                                                   )
                                     ] ;
                         rdfs:range :Screening .


###  http://example.com/school-ontology#performs
:performs rdf:type owl:ObjectProperty ;
          rdfs:subPropertyOf gufo:mediates ;
          rdfs:domain :DigitalCheckupSOS ;
          rdfs:range :Student .


###  http://example.com/school-ontology#planCreatedInIntervention
:planCreatedInIntervention rdf:type owl:ObjectProperty ;
                           rdfs:subPropertyOf gufo:wasCreatedIn ;
                           rdfs:domain :StudyPlan ;
                           rdfs:range :InterventionPlanning .


###  http://example.com/school-ontology#planParticipatesInSession
:planParticipatesInSession rdf:type owl:ObjectProperty ;
                           rdfs:subPropertyOf gufo:participatedIn ;
                           rdfs:domain :StudyPlan ;
                           rdfs:range :AlternativeLearningSession .


###  http://example.com/school-ontology#planParticipatesInTrial
:planParticipatesInTrial rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf gufo:participatedIn ;
                         rdfs:domain :StudyPlan ;
                         rdfs:range :DirectorsTrial .


###  http://example.com/school-ontology#recordCreatedInTrial
:recordCreatedInTrial rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf gufo:wasCreatedIn ;
                      rdfs:domain :StudentRecord ;
                      rdfs:range :DirectorsTrial .


###  http://example.com/school-ontology#reportCreatedInScreening
:reportCreatedInScreening rdf:type owl:ObjectProperty ;
                          rdfs:subPropertyOf gufo:wasCreatedIn ;
                          rdfs:domain :ActivityReport ;
                          rdfs:range :Screening .


###  http://example.com/school-ontology#sheetCreatedInScreening
:sheetCreatedInScreening rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf gufo:wasCreatedIn ;
                         rdfs:domain :SupportSheet ;
                         rdfs:range :Screening .


###  http://example.com/school-ontology#sheetParticipatesInIntervention
:sheetParticipatesInIntervention rdf:type owl:ObjectProperty ;
                                 rdfs:subPropertyOf gufo:participatedIn ;
                                 rdfs:domain :SupportSheet ;
                                 rdfs:range :InterventionPlanning .


###  http://example.com/school-ontology#socialWorkerParticipatesInIntervention
:socialWorkerParticipatesInIntervention rdf:type owl:ObjectProperty ;
                                        rdfs:subPropertyOf gufo:participatedIn ;
                                        rdfs:domain :SchoolSocialWorker ;
                                        rdfs:range :InterventionPlanning .


###  http://example.com/school-ontology#studentParticipatesInRefusalClassification
:studentParticipatesInRefusalClassification rdf:type owl:ObjectProperty ;
                                            rdfs:subPropertyOf gufo:participatedIn ;
                                            rdfs:domain :AbsentStudent ;
                                            rdfs:range :SchoolRefusalClassification .


###  http://example.com/school-ontology#studentStudiesAtSession
:studentStudiesAtSession rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf gufo:participatedIn ;
                         rdfs:domain :AbsentStudent ;
                         rdfs:range :AlternativeLearningSession ;
                         rdfs:label "Study at"@en .


###  http://example.com/school-ontology#terminatesClassification
:terminatesClassification rdf:type owl:ObjectProperty ;
                          rdfs:domain :ExcludedFactor ;
                          rdfs:range :SchoolRefusalClassification ;
                          rdfs:label "termination"@en .


###  http://example.com/school-ontology#triggers
:triggers rdf:type owl:ObjectProperty ;
          rdfs:domain :Screening ;
          rdfs:range :DigitalCheckupSOS ;
          rdfs:label "triggers"@en .


###  http://purl.org/nemo/gufo#wasCreatedIn
gufo:wasCreatedIn rdf:type owl:AsymmetricProperty ,
                           owl:IrreflexiveProperty .


#################################################################
#    Data properties
#################################################################

###  http://example.com/school-ontology#hasDaysAbsent
:hasDaysAbsent rdf:type owl:DatatypeProperty ;
               rdfs:domain :Student ;
               rdfs:range xsd:integer .


#################################################################
#    Classes
#################################################################

###  http://example.com/school-ontology#AbsenceDuration
:AbsenceDuration rdf:type owl:Class ;
                 rdfs:subClassOf gufo:Quality ;
                 owl:disjointWith :AbsenceMotive .


###  http://example.com/school-ontology#AbsenceMotive
:AbsenceMotive rdf:type owl:Class ;
               rdfs:subClassOf gufo:Quality .


###  http://example.com/school-ontology#AbsentStudent
:AbsentStudent rdf:type owl:Class ;
               owl:equivalentClass [ owl:intersectionOf ( :Student
                                                          [ rdf:type owl:Class ;
                                                            owl:complementOf [ rdf:type owl:Restriction ;
                                                                               owl:onProperty :hasAbsenceMotive ;
                                                                               owl:someValuesFrom :ExcludedFactor
                                                                             ]
                                                          ]
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty :hasDaysAbsent ;
                                                            owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                 owl:onDatatype xsd:integer ;
                                                                                 owl:withRestrictions ( [ xsd:minInclusive 30
                                                                                                        ]
                                                                                                      )
                                                                               ]
                                                          ]
                                                        ) ;
                                     rdf:type owl:Class
                                   ] ;
               rdfs:subClassOf :Student .


###  http://example.com/school-ontology#ActivityReport
:ActivityReport rdf:type owl:Class ;
                rdfs:subClassOf :Document .


###  http://example.com/school-ontology#AlternativeLearningSession
:AlternativeLearningSession rdf:type owl:Class ;
                            rdfs:subClassOf gufo:Event .


###  http://example.com/school-ontology#DigitalCheckupSOS
:DigitalCheckupSOS rdf:type owl:Class ;
                   rdfs:subClassOf gufo:Relator .


###  http://example.com/school-ontology#Director
:Director rdf:type owl:Class ;
          rdfs:subClassOf :Person .


###  http://example.com/school-ontology#DirectorsTrial
:DirectorsTrial rdf:type owl:Class ;
                rdfs:subClassOf gufo:Event .


###  http://example.com/school-ontology#Document
:Document rdf:type owl:Class ;
          rdfs:subClassOf gufo:Object .


###  http://example.com/school-ontology#EconomicReason
:EconomicReason rdf:type owl:Class ;
                rdfs:subClassOf :ExcludedFactor .


###  http://example.com/school-ontology#EducationSupportCenter
:EducationSupportCenter rdf:type owl:Class ;
                        rdfs:subClassOf :LearningFacility .


###  http://example.com/school-ontology#ExcludedFactor
:ExcludedFactor rdf:type owl:Class ;
                rdfs:subClassOf gufo:Object .


###  http://example.com/school-ontology#FreeSchool
:FreeSchool rdf:type owl:Class ;
            rdfs:subClassOf :LearningFacility .


###  http://example.com/school-ontology#HomeICT
:HomeICT rdf:type owl:Class ;
         rdfs:subClassOf :LearningFacility .


###  http://example.com/school-ontology#InSchoolSupportCenter
:InSchoolSupportCenter rdf:type owl:Class ;
                       rdfs:subClassOf :LearningFacility .


###  http://example.com/school-ontology#InterventionPlanning
:InterventionPlanning rdf:type owl:Class ;
                      rdfs:subClassOf gufo:Event .


###  http://example.com/school-ontology#LearningFacility
:LearningFacility rdf:type owl:Class ;
                  rdfs:subClassOf gufo:Object .


###  http://example.com/school-ontology#MEXT
:MEXT rdf:type owl:Class ;
      rdfs:subClassOf gufo:Object .


###  http://example.com/school-ontology#MedicalIllness
:MedicalIllness rdf:type owl:Class ;
                rdfs:subClassOf :ExcludedFactor .


###  http://example.com/school-ontology#Parent
:Parent rdf:type owl:Class ;
        rdfs:subClassOf :Person .


###  http://example.com/school-ontology#Person
:Person rdf:type owl:Class ;
        rdfs:subClassOf gufo:Object .


###  http://example.com/school-ontology#PsychosocialFactor
:PsychosocialFactor rdf:type owl:Class ;
                    rdfs:subClassOf gufo:IntrinsicMode .


###  http://example.com/school-ontology#RegularStudent
:RegularStudent rdf:type owl:Class ;
                rdfs:subClassOf :Student .


###  http://example.com/school-ontology#School
:School rdf:type owl:Class ;
        rdfs:subClassOf gufo:Object .


###  http://example.com/school-ontology#SchoolCounselor
:SchoolCounselor rdf:type owl:Class ;
                 rdfs:subClassOf :Person .


###  http://example.com/school-ontology#SchoolRefusalClassification
:SchoolRefusalClassification rdf:type owl:Class ;
                             rdfs:subClassOf gufo:Event .


###  http://example.com/school-ontology#SchoolSocialWorker
:SchoolSocialWorker rdf:type owl:Class ;
                    rdfs:subClassOf :Person .


###  http://example.com/school-ontology#Screening
:Screening rdf:type owl:Class ;
           rdfs:subClassOf gufo:Event .


###  http://example.com/school-ontology#Student
:Student rdf:type owl:Class ;
         rdfs:subClassOf :Person .


###  http://example.com/school-ontology#StudentRecord
:StudentRecord rdf:type owl:Class ;
               rdfs:subClassOf :Document .


###  http://example.com/school-ontology#StudyPlan
:StudyPlan rdf:type owl:Class ;
           rdfs:subClassOf :Document .


###  http://example.com/school-ontology#SupportSheet
:SupportSheet rdf:type owl:Class ;
              rdfs:subClassOf :Document .


###  http://example.com/school-ontology#Teacher
:Teacher rdf:type owl:Class ;
         rdfs:subClassOf :Person .


###  http://example.com/school-ontology#TeamSchool
:TeamSchool rdf:type owl:Class ;
            rdfs:subClassOf gufo:Collection .


###  http://example.com/school-ontology#UnjustifiedParentalBelief
:UnjustifiedParentalBelief rdf:type owl:Class ;
                           rdfs:subClassOf :ExcludedFactor .


