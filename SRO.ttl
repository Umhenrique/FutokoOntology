                           "疾患"@ja .


:Parent rdfs:label "Parent"@en ,
                   "Responsável"@pt-br ,
                   "保護者"@ja .


:Person rdfs:label "Person"@en ,
                   "Pessoa"@pt-br ,
                   "人物"@ja .


:PsychosocialFactor rdfs:label "Fator Psicossocial"@pt-br ,
                               "Psychosocial Factor"@en ,
                               "心理社会的要因"@ja .


:RegularStudent rdfs:label "Estudante Regular"@pt-br ,
                           "Regular Student"@en ,
                           "一般生徒"@ja .


:School rdfs:label "Escola"@pt-br ,
                   "School"@en ,
                   "学校"@ja .


